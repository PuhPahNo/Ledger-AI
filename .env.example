# Ledger AI Render environment variables
#
# This is the one env template to use for Render. Copy each key into both
# Render services unless noted:
#   - ledger-ai-web
#   - ledger-ai-worker
#
# Render supplies PORT automatically for web services. Do not add PORT unless
# you have a specific custom runtime reason.
#
# Generate secrets:
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 32   # APP_ENCRYPTION_KEY

# Frontend build vars. Required on ledger-ai-web only.
VITE_USE_MOCK_API=false
VITE_API_BASE=/api

# Runtime
NODE_ENV=production

# Render Postgres. If using render.yaml, this is wired automatically from the
# ledger-ai-postgres database. If entering manually, use Render's internal
# connection string.
DATABASE_URL=

# App URLs. Use your final Render URL or custom domain.
FRONTEND_ORIGIN=https://your-ledger-ai-web.onrender.com
PUBLIC_APP_URL=https://your-ledger-ai-web.onrender.com

# App secrets. Required on both web and worker.
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# Initial/admin reset user. Required for npm run db:seed and admin reset.
LEDGER_ADMIN_USERNAME=admin
LEDGER_ADMIN_PASSWORD=

# Receipt/file storage. Required on both web and worker.
STORAGE_DRIVER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=ledger-ai-receipts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OpenAI receipt extraction. Required on worker for OCR jobs.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini

# Plaid bank/card sync. Required on web and worker.
# Use sandbox until ready for live financial data.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=https://your-ledger-ai-web.onrender.com/api/webhooks/plaid

# Google Workspace / Gmail receipt discovery. Required on web and worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-ledger-ai-web.onrender.com/api/connections/gmail/callback
GOOGLE_PUBSUB_TOPIC=projects/<google-cloud-project-id>/topics/<gmail-topic-name>
